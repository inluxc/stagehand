# Playwright Framework - Local Environment Configuration
# Copy this file to .env.local and fill in the values for local development.
# These values override environments.json but are overridden by system env vars.

# ─── General ────────────────────────────────────────────────────────────────────

# Active environment name
PW_ENVIRONMENT=local

# ─── OpenAPI Configuration ──────────────────────────────────────────────────────

# Path to local OpenAPI spec file
PW_OPENAPI_SPEC_PATH=./specs/api.yaml

# Local API server URL
PW_OPENAPI_BASE_URL=http://localhost:3000

# ─── Database Configuration ─────────────────────────────────────────────────────

# Database type: postgresql, mysql, mssql, or sqlite
PW_DB_TYPE=postgresql

# Local database host
PW_DB_HOST=localhost

# Local database port
PW_DB_PORT=5432

# Local database name
PW_DB_NAME=testdb

# Local database username
PW_DB_USERNAME=test

# Local database password
PW_DB_PASSWORD=test

# ─── Kafka Configuration ───────────────────────────────────────────────────────

# Local Kafka broker address (comma-separated for multiple brokers)
PW_KAFKA_BROKERS=localhost:9092

# ─── RabbitMQ / AMQP Configuration ─────────────────────────────────────────────

# Broker URL (or PW_AMQP_HOST / PW_AMQP_PORT / PW_AMQP_USERNAME / PW_AMQP_PASSWORD / PW_AMQP_VHOST)
PW_AMQP_URL=amqp://testuser:testpass@localhost:5672

# ─── Redis Configuration ───────────────────────────────────────────────────────

# Local Redis host
PW_REDIS_HOST=localhost

# Local Redis port
PW_REDIS_PORT=6379

# Local Redis password (leave empty if no auth)
PW_REDIS_PASSWORD=

# Key prefix for test isolation
PW_REDIS_KEY_PREFIX=test:

# ─── Neo4j Configuration ───────────────────────────────────────────────────────

# Neo4j connection URI (bolt:// for a single server, neo4j:// for routing/cluster)
PW_NEO4J_URI=bolt://localhost:7687

# Neo4j username
PW_NEO4J_USERNAME=neo4j

# Neo4j password
PW_NEO4J_PASSWORD=testpassword

# Neo4j database name (leave empty to use the server's default database)
PW_NEO4J_DATABASE=

# ─── Appium Configuration ─────────────────────────────────────────────────────

# Appium server URL (local Appium, grid, cloud farm) — or the GADS hub URL
PW_APPIUM_SERVER_URL=http://127.0.0.1:4723

# Target platform: ios or android
PW_APPIUM_PLATFORM=android

# Device name (GADS: regex matched against device names) and/or exact UDID
PW_APPIUM_DEVICE_NAME=
PW_APPIUM_UDID=

# App to install (path, URL or farm app reference) — optional
PW_APPIUM_APP=

# Extra capabilities as a JSON object, e.g. {"appium:appPackage":"com.example.app"}
PW_APPIUM_CAPABILITIES=

# ─── GADS Device Farm (optional) ──────────────────────────────────────────────

# Setting a client secret routes sessions through the GADS hub at PW_APPIUM_SERVER_URL
# Create it under GADS Admin → Client credentials. Never commit a real value.
PW_GADS_CLIENT_SECRET=

# Seconds to wait for a free device (hub default 10, max 300)
PW_GADS_QUEUE_TIMEOUT=
