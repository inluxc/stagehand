{
    "name": "@inluxc/propmaster",
    "version": "1.0.0",
    "description": "Playwright Test fixtures for the services behind your UI: OpenAPI, GraphQL, SQL databases, MongoDB, Neo4j, Kafka, RabbitMQ, Redis, OTP and Appium/GADS.",
    "type": "module",
    "bin": {
        "propmaster": "dist/src/cli/init.js"
    },
    "main": "./dist/src/index.js",
    "module": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js",
            "default": "./dist/src/index.js"
        },
        "./config": {
            "types": "./dist/src/config/index.d.ts",
            "import": "./dist/src/config/index.js"
        },
        "./fixtures": {
            "types": "./dist/src/fixtures/index.d.ts",
            "import": "./dist/src/fixtures/index.js"
        },
        "./steps": {
            "types": "./dist/src/steps/index.d.ts",
            "import": "./dist/src/steps/index.js"
        },
        "./secrets": {
            "types": "./dist/src/secrets/index.d.ts",
            "import": "./dist/src/secrets/index.js"
        },
        "./errors": {
            "types": "./dist/src/errors.d.ts",
            "import": "./dist/src/errors.js"
        },
        "./cli": {
            "types": "./dist/src/cli/init.d.ts",
            "import": "./dist/src/cli/init.js"
        }
    },
    "files": [
        "dist/src",
        "README.md",
        "LICENSE",
        "environments.json"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "clean": "rm -rf dist",
        "prebuild": "npm run clean",
        "prepublishOnly": "npm run build",
        "release": "npm run build && npm publish --access public",
        "release:dry": "npm run build && npm publish --dry-run --access public",
        "test": "npx playwright test",
        "test:tag": "npx playwright test --grep",
        "typecheck": "tsc --noEmit",
        "lint:tests": "tsx src/cli/init.ts check",
        "next-id": "tsx src/cli/init.ts next-id",
        "verify": "npm run typecheck && npm run lint:tests && npx playwright test --project=unit-tests --project=property-tests",
        "docs:dev": "npm --prefix docs ci && npm --prefix docs run dev",
        "docs:build": "npm --prefix docs ci && npm --prefix docs run build"
    },
    "peerDependencies": {
        "@faker-js/faker": "^10.6.0",
        "@playwright/test": ">=1.50.0",
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "amqplib": "^2.2.0",
        "better-sqlite3": "^13.2.0",
        "graphql": "^16.15.0",
        "graphql-request": "^7.4.0",
        "ioredis": "^6.0.0",
        "js-yaml": "^4.3.2",
        "kafkajs": "^2.2.4",
        "mongodb": "^7.9.1",
        "mssql": "^12.7.16",
        "mysql2": "^3.24.6",
        "neo4j-driver": "^6.3.2",
        "openapi-client-axios": "^7.9.1",
        "otplib": "^13.6.0",
        "pg": "^8.23.1",
        "testcontainers": "^12.2.1",
        "webdriverio": "^9.33.1"
    },
    "peerDependenciesMeta": {
        "@faker-js/faker": {
            "optional": true
        },
        "ajv": {
            "optional": true
        },
        "ajv-formats": {
            "optional": true
        },
        "amqplib": {
            "optional": true
        },
        "better-sqlite3": {
            "optional": true
        },
        "graphql": {
            "optional": true
        },
        "graphql-request": {
            "optional": true
        },
        "ioredis": {
            "optional": true
        },
        "js-yaml": {
            "optional": true
        },
        "kafkajs": {
            "optional": true
        },
        "mongodb": {
            "optional": true
        },
        "mssql": {
            "optional": true
        },
        "mysql2": {
            "optional": true
        },
        "neo4j-driver": {
            "optional": true
        },
        "openapi-client-axios": {
            "optional": true
        },
        "otplib": {
            "optional": true
        },
        "pg": {
            "optional": true
        },
        "testcontainers": {
            "optional": true
        },
        "webdriverio": {
            "optional": true
        }
    },
    "devDependencies": {
        "@faker-js/faker": "^10.6.0",
        "@playwright/test": "^1.65.1",
        "@stoplight/prism-cli": "5.16.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/js-yaml": "^4.0.9",
        "@types/mssql": "^12.3.0",
        "@types/node": "^22.20.5",
        "@types/pg": "^8.23.1",
