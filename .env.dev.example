# Playwright Framework - Dev Environment Configuration
# Copy this file to .env.dev and fill in the values for the dev environment.
# These values override environments.json but are overridden by system env vars.

# ─── General ────────────────────────────────────────────────────────────────────

# Active environment name
PW_ENVIRONMENT=dev

# ─── OpenAPI Configuration ──────────────────────────────────────────────────────

# Remote OpenAPI spec URL for dev environment
PW_OPENAPI_SPEC_PATH=https://api.dev.example.com/openapi.json

# Dev API server URL
PW_OPENAPI_BASE_URL=https://api.dev.example.com

# ─── Database Configuration ─────────────────────────────────────────────────────

# Database type
PW_DB_TYPE=postgresql

# Dev database host
PW_DB_HOST=dev-db.example.com

# Dev database port
PW_DB_PORT=5432

# Dev database name
PW_DB_NAME=testdb

# Dev database username
PW_DB_USERNAME=dev_user

# Dev database password (retrieve from secrets provider or set here)
PW_DB_PASSWORD=

# ─── Kafka Configuration ───────────────────────────────────────────────────────

# Dev Kafka broker addresses (comma-separated)
PW_KAFKA_BROKERS=kafka.dev.example.com:9092

# ─── RabbitMQ / AMQP Configuration ─────────────────────────────────────────────

# Broker URL (or PW_AMQP_HOST / PW_AMQP_PORT / PW_AMQP_USERNAME / PW_AMQP_PASSWORD / PW_AMQP_VHOST)
PW_AMQP_URL=amqps://app:changeme@rabbitmq.dev.example.com:5671/app

# ─── Redis Configuration ───────────────────────────────────────────────────────

# Dev Redis host
PW_REDIS_HOST=redis.dev.example.com

# Dev Redis port
PW_REDIS_PORT=6379

# Dev Redis password
PW_REDIS_PASSWORD=

# Key prefix for test isolation in dev
PW_REDIS_KEY_PREFIX=test:dev:

# ─── Neo4j Configuration ───────────────────────────────────────────────────────

# Neo4j connection URI (bolt:// for a single server, neo4j:// for routing/cluster)
PW_NEO4J_URI=neo4j://neo4j.dev.example.com:7687

# Neo4j username
PW_NEO4J_USERNAME=neo4j

# Neo4j password
PW_NEO4J_PASSWORD=

# Neo4j database name (leave empty to use the server's default database)
PW_NEO4J_DATABASE=

# ─── Appium Configuration ─────────────────────────────────────────────────────

# Appium server URL (local Appium, grid, cloud farm) — or the GADS hub URL
PW_APPIUM_SERVER_URL=http://gads.dev.example.com:10000

# Target platform: ios or android
PW_APPIUM_PLATFORM=android

# Device name (GADS: regex matched against device names) and/or exact UDID
PW_APPIUM_DEVICE_NAME=
PW_APPIUM_UDID=

# App to install (path, URL or farm app reference) — optional
PW_APPIUM_APP=

# Extra capabilities as a JSON object, e.g. {"appium:appPackage":"com.example.app"}
PW_APPIUM_CAPABILITIES=

# ─── GADS Device Farm (optional) ──────────────────────────────────────────────

# Setting a client secret routes sessions through the GADS hub at PW_APPIUM_SERVER_URL
# Create it under GADS Admin → Client credentials. Never commit a real value.
PW_GADS_CLIENT_SECRET=

# Seconds to wait for a free device (hub default 10, max 300)
PW_GADS_QUEUE_TIMEOUT=60
